{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engirdle:contracts:catalog:v1",
  "title": "Engirdle Catalog v1",
  "type": "object",
  "required": ["catalog_version", "generated_at", "packages"],
  "properties": {
    "catalog_version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "generated_at": {"type": "string", "format": "date-time"},
    "packages": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/package"}
    },
    "dictionaries": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/dictionary"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positiveInteger": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "package": {
      "type": "object",
      "required": [
        "article_id",
        "revision",
        "artifact_revision",
        "title",
        "format_version",
        "size",
        "sha256",
        "url"
      ],
      "properties": {
        "article_id": {"$ref": "#/$defs/uuid"},
        "revision": {"$ref": "#/$defs/positiveInteger"},
        "artifact_revision": {"$ref": "#/$defs/positiveInteger"},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "format_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
        "size": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "sha256": {"$ref": "#/$defs/sha256"},
        "url": {
          "type": "string",
          "maxLength": 2048,
          "oneOf": [
            {"pattern": "^/packages/[A-Za-z0-9][A-Za-z0-9._-]{0,199}\\.readpack$"},
            {
              "format": "uri",
              "pattern": "^https?://[^/@?#]+/packages/[A-Za-z0-9][A-Za-z0-9._-]{0,199}\\.readpack$"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "dictionary": {
      "type": "object",
      "required": [
        "dictionary_id",
        "revision",
        "format_version",
        "schema_version",
        "display_name",
        "size",
        "sha256",
        "url"
      ],
      "properties": {
        "dictionary_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {"$ref": "#/$defs/positiveInteger"},
        "format_version": {"type": "string", "pattern": "^2\\.[0-9]+$"},
        "schema_version": {"$ref": "#/$defs/positiveInteger"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "size": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "sha256": {"$ref": "#/$defs/sha256"},
        "url": {
          "type": "string",
          "maxLength": 2048,
          "oneOf": [
            {"pattern": "^/dictionaries/[A-Za-z0-9][A-Za-z0-9._-]{0,199}\\.dictpack$"},
            {
              "format": "uri",
              "pattern": "^https?://[^/@?#]+/dictionaries/[A-Za-z0-9][A-Za-z0-9._-]{0,199}\\.dictpack$"
            }
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
