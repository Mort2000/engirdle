{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engirdle:contracts:readpack:v2:manifest",
  "title": "Engirdle Readpack v2 manifest",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "package_id",
    "created_at",
    "article",
    "files",
    "content",
    "derivatives"
  ],
  "properties": {
    "format": {"const": "readpack"},
    "format_version": {"$ref": "#/$defs/v2Version"},
    "required_capabilities": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "package_id": {"$ref": "#/$defs/uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "article": {
      "type": "object",
      "required": ["id", "revision", "artifact_revision"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "revision": {"$ref": "#/$defs/positiveInteger"},
        "artifact_revision": {"$ref": "#/$defs/positiveInteger"}
      },
      "additionalProperties": true
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/articleFile"},
          {"$ref": "#/$defs/attributionFile"},
          {"$ref": "#/$defs/translationFile"},
          {"$ref": "#/$defs/narrationFile"},
          {"$ref": "#/$defs/audioFile"}
        ]
      },
      "allOf": [
        {"contains": {"$ref": "#/$defs/articleFile"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/attributionFile"}, "minContains": 1, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/narrationFile"}, "minContains": 0, "maxContains": 1},
        {"contains": {"$ref": "#/$defs/audioFile"}, "minContains": 0, "maxContains": 1}
      ]
    },
    "content": {
      "type": "object",
      "required": ["path", "structure_sha256", "segmenter"],
      "properties": {
        "path": {"const": "article.json"},
        "structure_sha256": {"$ref": "#/$defs/sha256"},
        "parser": {"$ref": "#/$defs/revisionedIdentifier"},
        "segmenter": {"$ref": "#/$defs/revisionedIdentifier"}
      },
      "additionalProperties": true
    },
    "derivatives": {
      "type": "object",
      "required": ["translations", "narration"],
      "properties": {
        "translations": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/translationDescriptor"}
        },
        "narration": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/narrationDescriptor"}
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "derivatives": {
            "properties": {
              "narration": {"type": "object"}
            },
            "required": ["narration"]
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "allOf": [
              {"contains": {"$ref": "#/$defs/narrationFile"}, "minContains": 1},
              {"contains": {"$ref": "#/$defs/audioFile"}, "minContains": 1}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "v2Version": {"type": "string", "pattern": "^2\\.[0-9]+$"},
    "uuid": {"type": "string", "format": "uuid"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positiveInteger": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "revisionedIdentifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^.+@[^@]+$"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "fileBase": {
      "type": "object",
      "required": ["path", "size", "sha256", "media_type"],
      "properties": {
        "size": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "articleFile": {
      "allOf": [
        {"$ref": "#/$defs/fileBase"},
        {
          "type": "object",
          "properties": {
            "path": {"const": "article.json"},
            "media_type": {"const": "application/json"}
          }
        }
      ]
    },
    "attributionFile": {
      "allOf": [
        {"$ref": "#/$defs/fileBase"},
        {
          "type": "object",
          "properties": {
            "path": {"const": "attribution.json"},
            "media_type": {"const": "application/json"}
          }
        }
      ]
    },
    "translationFile": {
      "allOf": [
        {"$ref": "#/$defs/fileBase"},
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^derivatives/translation\\.[A-Za-z0-9]{2,8}(-[A-Za-z0-9]{2,8})*\\.json$"
            },
            "media_type": {"const": "application/json"}
          }
        }
      ]
    },
    "narrationFile": {
      "allOf": [
        {"$ref": "#/$defs/fileBase"},
        {
          "type": "object",
          "properties": {
            "path": {"const": "derivatives/narration.json"},
            "media_type": {"const": "application/json"}
          }
        }
      ]
    },
    "audioFile": {
      "allOf": [
        {"$ref": "#/$defs/fileBase"},
        {
          "type": "object",
          "properties": {
            "path": {"const": "audio/article.m4a"},
            "media_type": {"const": "audio/mp4"}
          }
        }
      ]
    },
    "translationDescriptor": {
      "type": "object",
      "required": ["locale", "path"],
      "properties": {
        "locale": {"$ref": "#/$defs/locale"},
        "path": {
          "type": "string",
          "pattern": "^derivatives/translation\\.[A-Za-z0-9]{2,8}(-[A-Za-z0-9]{2,8})*\\.json$"
        }
      },
      "additionalProperties": true
    },
    "narrationDescriptor": {
      "type": "object",
      "required": ["path", "audio_path"],
      "properties": {
        "path": {"const": "derivatives/narration.json"},
        "audio_path": {"const": "audio/article.m4a"}
      },
      "additionalProperties": true
    }
  }
}
