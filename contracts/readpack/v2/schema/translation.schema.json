{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engirdle:contracts:readpack:v2:translation",
  "title": "Engirdle Readpack v2 translation derivative",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "article",
    "structure_sha256",
    "target_locale",
    "sentences",
    "tables",
    "pipeline"
  ],
  "properties": {
    "format": {"const": "readpack-translation"},
    "format_version": {"$ref": "#/$defs/v2Version"},
    "article": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "revision": {"$ref": "#/$defs/positiveInteger"}
      },
      "additionalProperties": true
    },
    "structure_sha256": {"$ref": "#/$defs/sha256"},
    "target_locale": {"$ref": "#/$defs/locale"},
    "sentences": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["sentence_id", "text"],
        "properties": {
          "sentence_id": {"$ref": "#/$defs/opaqueId"},
          "text": {"type": "string", "minLength": 1, "maxLength": 40000}
        },
        "additionalProperties": true
      }
    },
    "tables": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["block_id", "cells"],
        "properties": {
          "block_id": {"$ref": "#/$defs/opaqueId"},
          "cells": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8192,
            "items": {
              "type": "object",
              "required": ["cell_id", "text"],
              "properties": {
                "cell_id": {"$ref": "#/$defs/opaqueId"},
                "text": {"type": "string", "minLength": 1, "maxLength": 40000}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "pipeline": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "prompt",
        "thinking",
        "reasoning_effort",
        "created_at",
        "client_version"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 512},
        "model": {"type": "string", "minLength": 1, "maxLength": 512},
        "prompt": {"$ref": "#/$defs/revisionedIdentifier"},
        "thinking": {"type": "string", "minLength": 1, "maxLength": 512},
        "reasoning_effort": {"type": "string", "minLength": 1, "maxLength": 512},
        "created_at": {"type": "string", "format": "date-time"},
        "client_version": {"$ref": "#/$defs/semanticVersion"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "v2Version": {"type": "string", "pattern": "^2\\.[0-9]+$"},
    "uuid": {"type": "string", "format": "uuid"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positiveInteger": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "revisionedIdentifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^.+@[^@]+$"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
