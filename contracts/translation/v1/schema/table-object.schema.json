{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engirdle:contracts:translation:v1:table-object",
  "title": "Engirdle translation v1 table-unit wire (request and response)",
  "type": "object",
  "required": ["block_id", "columns", "alignments", "header", "rows"],
  "properties": {
    "block_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "columns": {"type": "integer", "minimum": 1, "maximum": 32},
    "alignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"enum": ["default", "left", "center", "right"]}
    },
    "header": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/cell"}
    },
    "rows": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {"$ref": "#/$defs/cell"}
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "cell": {
      "type": "object",
      "required": ["cell_id", "text"],
      "properties": {
        "cell_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "text": {"type": "string", "minLength": 1, "maxLength": 40000}
      },
      "additionalProperties": false
    }
  }
}
