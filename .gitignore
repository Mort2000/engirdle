# Local Qwen3-TTS reference assets and model checkpoints.
# The application must build and run without this directory.
/.tts/

# Python development and build outputs
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
**/dist/
**/build/

# Engirdle runtime data belongs outside the source tree.
**/workspace/

# Local Flutter SDK used for development verification, never committed.
/.scratch/flutter/
/.scratch/flutter_*.tar.xz

# Flutter/Dart build outputs
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins*
apps/mobile/.packages
apps/mobile/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
