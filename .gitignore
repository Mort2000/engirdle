# Local Qwen3-TTS reference assets and model checkpoints.
# The application must build and run without this directory.
/.tts/

# Python development and build outputs
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
**/dist/
**/build/

# Admin frontend (Vite) local outputs; node_modules and the hatch build cache
# (admin_frontend/.build-cache.json, see design §10) stay out of the tree.
apps/pc/admin_frontend/node_modules/
apps/pc/admin_frontend/.build-cache.json
# openapi.json is a regenerated intermediate (scripts/export_openapi.py);
# the committed contract artifact is src/api/types.generated.ts.
apps/pc/admin_frontend/openapi.json

# Local secrets — never committed (e.g. DEEPSEEK_API_KEY for manual testing).
.env
**/.env

# Engirdle runtime data belongs outside the source tree.
**/workspace/

# App-generated scratch output (e.g. manual TTS smoke audio), never committed.
/apps/pc/.scratch/

# Local Flutter SDK used for development verification, never committed.
/.scratch/flutter/
/.scratch/flutter_*.tar.xz
/.scratch/dictsrc/

# Flutter/Dart build outputs
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins*
apps/mobile/.packages
apps/mobile/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# Local browser automation, pipeline runs, and manual experiment artifacts.
/.browser-tasks/
/.pipeline-run/
/.scratch/e2e/
/.scratch/*.log
/.scratch/bench_*.py
/.scratch/report_queued_job_tts.py
/.scratch/formal_tts_batch_smoke.py
/.scratch/formal_tts_smoke/
/.scratch/tts_acceleration_benchmark/
/.scratch/tts_job_experiments/
/apps/mobile/tool/_diag_*.dart

# Keep new scratch material local; existing tracked documents are unchanged.
/.scratch/
